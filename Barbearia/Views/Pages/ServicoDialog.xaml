<Window x:Class="Barbearia.Views.Pages.ServicoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Serviço" Height="350" Width="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#0D0D00">
    <StackPanel Margin="30">
        <TextBlock x:Name="TxtTitulo" Text="Novo Serviço"
                   FontSize="20" FontWeight="Bold" Foreground="#D4A017" Margin="0,0,0,24"/>
        <TextBlock Text="Nome *" Foreground="#A08040" Margin="0,0,0,4"/>
        <TextBox x:Name="TxtNome" Margin="0,0,0,12" Height="45"/>
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Preço (R$) *" Foreground="#A08040" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtPreco" Height="45" Text="0"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Duração (min) *" Foreground="#A08040" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtDuracao" Height="45" Text="30"/>
            </StackPanel>
        </Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancelar" Style="{StaticResource BtnSecondary}"
                    Margin="0,0,10,0" Width="90" Click="BtnCancelar_Click"/>
            <Button Content="Salvar" Style="{StaticResource BtnPrimary}"
                    Width="90" Click="BtnSalvar_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
