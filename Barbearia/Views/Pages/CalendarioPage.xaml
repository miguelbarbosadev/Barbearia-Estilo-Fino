<Page x:Class="Barbearia.Views.Pages.CalendarioPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Calendário" Background="#0D0D00">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <TextBlock Grid.Row="0" Text="📅 Calendário de Agendamentos"
                   FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,0,0,20"/>

        <!-- Navegação do mês -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="◀" Style="{StaticResource BtnSecondary}"
                    Width="40" Click="BtnMesAnterior_Click"/>
            <TextBlock Grid.Column="1" x:Name="TxtMesAtual"
                       FontSize="18" FontWeight="SemiBold" Foreground="#D4A017"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Button Grid.Column="2" Content="▶" Style="{StaticResource BtnSecondary}"
                    Width="40" Click="BtnProximoMes_Click"/>
        </Grid>

        <!-- Grid do calendário -->
        <Border Grid.Row="2" Background="#1A1400" CornerRadius="12" Padding="16"
                BorderBrush="#3A2C00" BorderThickness="1">
            <StackPanel>
                <!-- Cabeçalho dos dias da semana -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Dom" HorizontalAlignment="Center"
                               Foreground="#D4A017" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="1" Text="Seg" HorizontalAlignment="Center"
                               Foreground="#A08040" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="2" Text="Ter" HorizontalAlignment="Center"
                               Foreground="#A08040" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="3" Text="Qua" HorizontalAlignment="Center"
                               Foreground="#A08040" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="4" Text="Qui" HorizontalAlignment="Center"
                               Foreground="#A08040" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="5" Text="Sex" HorizontalAlignment="Center"
                               Foreground="#A08040" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="6" Text="Sáb" HorizontalAlignment="Center"
                               Foreground="#D4A017" FontWeight="SemiBold"/>
                </Grid>

                <!-- Células dos dias (criadas por código) -->
                <UniformGrid x:Name="GridCalendario" Rows="6" Columns="7" MinHeight="380"/>
            </StackPanel>
        </Border>

        <!-- Lista de agendamentos do dia selecionado -->
        <Border Grid.Row="3" Background="#1A1400" CornerRadius="12"
                Padding="20" Margin="0,16,0,0"
                BorderBrush="#3A2C00" BorderThickness="1">
            <StackPanel>
                <TextBlock x:Name="TxtDiaSelecionado" FontSize="15" FontWeight="SemiBold"
                           Foreground="#D4A017" Margin="0,0,0,10"
                           Text="Clique em um dia para ver os agendamentos"/>
                <ItemsControl x:Name="ListAgendamentosDia">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#2A1E00" CornerRadius="8"
                                    Margin="0,4" Padding="14,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding DataHora, StringFormat=HH:mm}"
                                               FontWeight="Bold" Foreground="#D4A017" FontSize="15"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Cliente.Nome}"
                                               Foreground="White" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Servico.Nome}"
                                               Foreground="#A08040" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3"
                                               Text="{Binding Status}"
                                               Foreground="#27AE60" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </Grid>
</Page>
