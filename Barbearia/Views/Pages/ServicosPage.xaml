<Page x:Class="Barbearia.Views.Pages.ServicosPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Serviços" Background="#0D0D00">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="✂ Serviços" FontSize="24" FontWeight="Bold" Foreground="White"/>
            <Button Content="+ Novo Serviço" Style="{StaticResource BtnPrimary}"
                    HorizontalAlignment="Right" Click="BtnNovo_Click"/>
        </Grid>

        <DataGrid Grid.Row="1" x:Name="GridServicos">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="*"/>
                <DataGridTextColumn Header="Preço" Binding="{Binding Preco, StringFormat=C2}" Width="100"/>
                <DataGridTextColumn Header="Duração (min)" Binding="{Binding DuracaoMinutos}" Width="110"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="✏ Editar" Style="{StaticResource BtnSecondary}"
                    Margin="0,0,8,0" Click="BtnEditar_Click"/>
            <Button Content="🗑 Excluir" Style="{StaticResource BtnDanger}"
                    Click="BtnExcluir_Click"/>
        </StackPanel>
    </Grid>
</Page>
