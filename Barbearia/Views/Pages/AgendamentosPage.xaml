<Page x:Class="Barbearia.Views.Pages.AgendamentosPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Agendamentos" Background="#0D0D00">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="🕐 Agendamentos" FontSize="24" FontWeight="Bold" Foreground="White"/>
            <Button Content="+ Novo Agendamento" Style="{StaticResource BtnPrimary}"
                    HorizontalAlignment="Right" Click="BtnNovo_Click"/>
        </Grid>

        <!-- Filtros -->
        <Border Grid.Row="1" Background="#1A1400" CornerRadius="10" Padding="16" Margin="0,0,0,16"
                BorderBrush="#3A2C00" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="De:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#A08040"/>
                <DatePicker Grid.Column="1" x:Name="FiltroDataInicio" Margin="0,0,12,0"/>
                <TextBlock Grid.Column="2" Text="Até:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#A08040"/>
                <DatePicker Grid.Column="3" x:Name="FiltroDataFim" Margin="0,0,12,0"/>
                <TextBlock Grid.Column="4" Text="Status:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#A08040"/>
                <ComboBox Grid.Column="5" x:Name="FiltroStatus" Margin="0,0,12,0" SelectionChanged="FiltroStatus_SelectionChanged">
                    <ComboBoxItem Content="Todos" IsSelected="True"/>
                    <ComboBoxItem Content="Agendado"/>
                    <ComboBoxItem Content="Concluido"/>
                    <ComboBoxItem Content="Cancelado"/>
                </ComboBox>
                <Button Grid.Column="6" Content="🔍 Filtrar" Style="{StaticResource BtnSecondary}"
                        Click="BtnFiltrar_Click"/>
            </Grid>
        </Border>

        <!-- Lista de agendamentos -->
        <DataGrid Grid.Row="2" x:Name="GridAgendamentos"
                  SelectionChanged="GridAgendamentos_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Data/Hora" Binding="{Binding DataHora, StringFormat=dd/MM/yyyy HH:mm}" Width="140"/>
                <DataGridTextColumn Header="Cliente" Binding="{Binding Cliente.Nome}" Width="*"/>
                <DataGridTextColumn Header="Barbeiro" Binding="{Binding Barbeiro.Nome}" Width="*"/>
                <DataGridTextColumn Header="Serviço" Binding="{Binding Servico.Nome}" Width="*"/>
                <DataGridTextColumn Header="Valor" Binding="{Binding Servico.Preco, StringFormat=C2}" Width="90"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Botões de ação -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0" HorizontalAlignment="Right">
            <Button Content="✏ Editar" Style="{StaticResource BtnSecondary}"
                    Margin="0,0,8,0" Click="BtnEditar_Click"/>
            <Button Content="✔ Concluir" Style="{StaticResource BtnSecondary}"
                    Margin="0,0,8,0" Click="BtnConcluir_Click"
                    Background="#27AE60"/>
            <Button Content="✖ Cancelar Ag." Style="{StaticResource BtnDanger}"
                    Margin="0,0,8,0" Click="BtnCancelar_Click"/>
            <Button Content="🗑 Excluir" Style="{StaticResource BtnDanger}"
                    Click="BtnExcluir_Click"/>
        </StackPanel>
    </Grid>
</Page>
