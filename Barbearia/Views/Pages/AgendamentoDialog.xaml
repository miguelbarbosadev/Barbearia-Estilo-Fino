<Window x:Class="Barbearia.Views.Pages.AgendamentoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Agendamento" Height="620" Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#0D0D00">

    <StackPanel Margin="30">
        <TextBlock x:Name="TxtTitulo" Text="Novo Agendamento"
                   FontSize="20" FontWeight="Bold" Foreground="#D4A017" Margin="0,0,0,24"/>

        <TextBlock Text="Cliente" Margin="0,0,0,4" Foreground="#A08040"/>
        <ComboBox x:Name="CbCliente" DisplayMemberPath="Nome" Margin="0,0,0,14" Height="45"/>

        <TextBlock Text="Barbeiro" Margin="0,0,0,4" Foreground="#A08040"/>
        <ComboBox x:Name="CbBarbeiro" DisplayMemberPath="Nome" Margin="0,0,0,14" Height="45"/>

        <TextBlock Text="Serviço" Margin="0,0,0,4" Foreground="#A08040"/>
        <ComboBox x:Name="CbServico" DisplayMemberPath="Nome" Margin="0,0,0,14" Height="45"/>

        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Data" Margin="0,0,0,4" Foreground="#A08040"/>
                <DatePicker x:Name="DpData" Height="46" RenderTransformOrigin="0.5,1.013"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Horário (HH:mm)" Margin="0,0,0,4" Foreground="#A08040"/>
                <TextBox x:Name="TxtHorario" Text="09:00" Height="46"/>
            </StackPanel>
        </Grid>

        <TextBlock Text="Observações" Margin="0,0,0,4" Foreground="#A08040"/>
        <TextBox x:Name="TxtObs" Height="60" TextWrapping="Wrap"
                 AcceptsReturn="True" Margin="0,0,0,24" RenderTransformOrigin="0.509,0.461"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" Style="{StaticResource BtnSecondary}"
                    Margin="0,0,10,0" Click="BtnCancelar_Click" Width="90"/>
            <Button Content="Salvar" Style="{StaticResource BtnPrimary}"
                    Click="BtnSalvar_Click" Width="90"/>
        </StackPanel>
    </StackPanel>
</Window>
