<Window x:Class="Barbearia.Views.Pages.ClienteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cliente" Height="430" Width="500"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#0D0D00">
    <StackPanel Margin="30">
        <TextBlock x:Name="TxtTitulo" Text="Novo Cliente"
                   FontSize="20" FontWeight="Bold" Foreground="#D4A017" Margin="0,0,0,24"/>

        <TextBlock Text="Nome *" Foreground="#A08040" Margin="0,0,0,4"/>
        <TextBox x:Name="TxtNome" Margin="0,0,0,12" Height="45"/>

        <TextBlock Text="Telefone" Foreground="#A08040" Margin="0,0,0,4"/>
        <TextBox x:Name="TxtTelefone" Margin="0,0,0,12" Height="45"/>

        <TextBlock Text="E-mail" Foreground="#A08040" Margin="0,0,0,4"/>
        <TextBox x:Name="TxtEmail" Margin="0,0,0,24" Height="45"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" Style="{StaticResource BtnSecondary}"
                    Margin="0,0,10,0" Width="90" Click="BtnCancelar_Click"/>
            <Button Content="Salvar" Style="{StaticResource BtnPrimary}"
                    Width="90" Click="BtnSalvar_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
